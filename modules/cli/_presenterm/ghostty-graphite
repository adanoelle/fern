# Ghostty overlay for presenting — graphite profile.
# Layered on top of the normal config by `present --theme graphite`:
#   ghostty --config-file=~/.config/ghostty/graphite -e presenterm --theme graphite deck.md
# Keybinds and everything not listed here come from the main config.

# ── Font: a plain monospace with no ligatures, so operators on slides read
#    as typed. 20pt fills ~110 columns at 1080p; ctrl+= / ctrl+- step it.
font-family =
font-family = IBM Plex Mono
font-family = FiraCode Nerd Font
font-size = 20
font-feature = -calt
font-feature = -liga
bold-is-bright = false

# ── Window: fullscreen, generous margin, nothing else on screen
fullscreen = true
window-decoration = none
window-padding-x = 32
window-padding-y = 24
window-padding-balance = true
confirm-close-surface = false
mouse-hide-while-typing = true
title = presenterm

# ── Cursor: amber block, no blink
cursor-style = block
cursor-style-blink = false
cursor-color = #f0b429
cursor-text = #16181d

# ── Colours: warm near-black, GitHub Dark ANSI set (every slot ≥ 4.5:1)
background = #16181d
foreground = #e6e1d6
selection-background = #34405a
selection-foreground = #e6e1d6

palette = 0=#2d333b
palette = 1=#f47067
palette = 2=#57ab5a
palette = 3=#c69026
palette = 4=#539bf5
palette = 5=#b083f0
palette = 6=#39c5cf
palette = 7=#adbac7
palette = 8=#768390
palette = 9=#ff938a
palette = 10=#6bc46d
palette = 11=#daaa3f
palette = 12=#6cb6ff
palette = 13=#dcbdfb
palette = 14=#56d4dd
palette = 15=#e6e1d6
